<?xml version="1.0"?>
<!--
  six_axis_arm.urdf.xacro
  ------------------------------------------------------------
  Starting-point URDF for a 6-DOF arm: base, shoulder, elbow,
  wrist pitch, wrist roll, gripper.

  This is a PLACEHOLDER geometry (boxes/cylinders, guessed link
  lengths) so the robot can be loaded, visualized in RViz, and run
  through MoveIt Setup Assistant right away. Replace the <geometry>
  and <origin> values with your actual link lengths and, ideally,
  real meshes once you have them.

  Joint order below (and their names) MUST match JOINT_NAMES in
  arduino_arm_bridge.py and the channel order in the Arduino sketch:
    0 joint_base          1 joint_shoulder      2 joint_elbow
    3 joint_wrist_pitch   4 joint_wrist_roll    5 joint_gripper
  ------------------------------------------------------------
-->
<robot name="six_axis_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="grey"><color rgba="0.6 0.6 0.6 1"/></material>
  <material name="dark"><color rgba="0.2 0.2 0.2 1"/></material>

  <link name="base_link">
    <visual>
      <geometry><cylinder radius="0.05" length="0.03"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.05" length="0.03"/></geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <xacro:macro name="link_box" params="name length mass">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 ${length/2}" rpy="0 0 0"/>
        <geometry><box size="0.03 0.03 ${length}"/></geometry>
        <material name="grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${length/2}" rpy="0 0 0"/>
        <geometry><box size="0.03 0.03 ${length}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 ${length/2}" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0002"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:link_box name="link_shoulder" length="0.10" mass="0.15"/>
  <xacro:link_box name="link_upper_arm" length="0.12" mass="0.15"/>
  <xacro:link_box name="link_forearm" length="0.10" mass="0.10"/>
  <xacro:link_box name="link_wrist" length="0.05" mass="0.05"/>
  <xacro:link_box name="link_gripper_base" length="0.04" mass="0.05"/>

  <!-- 0: base rotation, MG995, +/-90 deg about Z -->
  <joint name="joint_base" type="revolute">
    <parent link="base_link"/>
    <child link="link_shoulder"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="10" velocity="1.5"/>
  </joint>

  <!-- 1: shoulder, MG995, +/-90 deg about Y -->
  <joint name="joint_shoulder" type="revolute">
    <parent link="link_shoulder"/>
    <child link="link_upper_arm"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="10" velocity="1.5"/>
  </joint>

  <!-- 2: elbow, MG995, +/-90 deg about Y -->
  <joint name="joint_elbow" type="revolute">
    <parent link="link_upper_arm"/>
    <child link="link_forearm"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="8" velocity="1.5"/>
  </joint>

  <!-- 3: wrist pitch, SG90, +/-90 deg about Y -->
  <joint name="joint_wrist_pitch" type="revolute">
    <parent link="link_forearm"/>
    <child link="link_wrist"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="2" velocity="2.0"/>
  </joint>

  <!-- 4: wrist roll, SG90, +/-90 deg about Z -->
  <joint name="joint_wrist_roll" type="revolute">
    <parent link="link_wrist"/>
    <child link="link_gripper_base"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="1" velocity="2.0"/>
  </joint>

  <!-- 5: gripper open/close, SG90 -->
  <link name="link_gripper_finger">
    <visual>
      <geometry><box size="0.02 0.03 0.02"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry><box size="0.02 0.03 0.02"/></geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="joint_gripper" type="revolute">
    <parent link="link_gripper_base"/>
    <child link="link_gripper_finger"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="1.0472" effort="1" velocity="2.0"/>
  </joint>

</robot>
